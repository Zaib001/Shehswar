model Vehicle {
  id                 String              @id @default(uuid()) @db.Uuid
  organizationId     String              @db.Uuid
  companyId          String              @db.Uuid
  vehicleNumber      String              @db.VarChar(50) // e.g. "ABC-123"
  companyName        String?             @db.VarChar(200)
  vehicleModel       String              @db.VarChar(100) // e.g. "Toyota Corolla GLI"
  registrationYear   Int                 // e.g. 2022
  engineNumber       String?             @db.VarChar(100)
  chassisNumber      String?             @db.VarChar(100)
  status             String              @default("AVAILABLE") @db.VarChar(50) // AVAILABLE, ASSIGNED, UNDER_MAINTENANCE, SOLD, DISPOSED, INACTIVE
  currentEmployeeId  String?             @db.Uuid
  assignmentDate     DateTime?           @db.Timestamptz(6)
  currentLocation    String?             @default("Head Office") @db.VarChar(150)
  notes              String?             @db.Text
  createdAt          DateTime            @default(now()) @db.Timestamptz(6)
