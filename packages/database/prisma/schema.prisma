model Dealer {
  id                     String            @id @default(uuid()) @db.Uuid
  organizationId         String            @db.Uuid
  companyId              String            @db.Uuid
  territoryId            String?           @db.Uuid
  assignedFieldOfficerId String?           @db.Uuid
  code                   String            @db.VarChar(50)
  name                   String            @db.VarChar(200)
  businessName           String?           @db.VarChar(200)
  contactPerson          String?           @db.VarChar(100)
  phone                  String            @db.VarChar(50)
  email                  String?           @db.VarChar(255)
  city                   String?           @db.VarChar(100)
  address                String?           @db.Text
  creditLimit            Decimal           @default(0) @db.Decimal(18, 2)
  currentBalance         Decimal           @default(0) @db.Decimal(18, 2)
  annualAgreementTarget  Decimal?          @default(0) @db.Decimal(18, 2)
  monthlySalesTarget     Decimal?          @default(0) @db.Decimal(18, 2)
  status                 String            @default("ACTIVE") @db.VarChar(50)
  notes                  String?           @db.Text
  createdAt              DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt              DateTime?         @db.Timestamptz(6)

  organization           Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  territory              Territory?        @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  assignedOfficer        User?             @relation("DealerAssignedOfficer", fields: [assignedFieldOfficerId], references: [id], onDelete: SetNull)
