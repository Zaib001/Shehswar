  assignments        VehicleAssignment[]
  expenses           VehicleExpense[]

  @@unique([companyId, vehicleNumber])
  @@index([organizationId])
  @@index([companyId])
  @@index([currentEmployeeId])
  @@index([status])
  @@map("vehicles")
}

model VehicleAssignment {
