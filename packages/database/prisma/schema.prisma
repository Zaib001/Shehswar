  partyName          String?      @db.VarChar(200)
  amount             Decimal      @db.Decimal(18, 2)
  paymentMethod      String       @db.VarChar(50) // CASH, BANK, CHEQUE, ONLINE, DD, OTHER
  accountId          String       @db.Uuid        // Cash / Bank account
  contraAccountId    String       @db.Uuid        // Counter ledger account
  bankName           String?      @db.VarChar(100)
