  warehouseId        String          @db.Uuid
  invoiceDate        DateTime        @db.Timestamptz(6)
  postingStatus      String          @default("DRAFT") @db.VarChar(50) // DRAFT, POSTED, CANCELLED
  grossAmount        Decimal         @default(0) @db.Decimal(18, 4)
  discountAmount     Decimal         @default(0) @db.Decimal(18, 4)
  taxAmount          Decimal         @default(0) @db.Decimal(18, 4)
  netAmount          Decimal         @default(0) @db.Decimal(18, 4)
  notes              String?         @db.Text
  createdById        String?         @db.VarChar(100)
  postedAt           DateTime?       @db.Timestamptz(6)

  // ─────────────────────────────────────────────────────────
  // IMMUTABLE MARKET ATTRIBUTION SNAPSHOT AT TIME OF POSTING
  // ─────────────────────────────────────────────────────────
  salesOfficerId     String?         @db.Uuid // Responsible SO / FO
  territoryId        String?         @db.Uuid // Territory at posting
  zoneId             String?         @db.Uuid // Zone at posting
  areaManagerId      String?         @db.Uuid // Responsible Area Manager
  regionId           String?         @db.Uuid // Region at posting
  businessManagerId  String?         @db.Uuid // Responsible Business Manager

  // Presentation Format & Commercial Attributes
  documentFormat     String          @default("COMMERCIAL_FULL") @db.VarChar(50) // BASIC_DELIVERY | STANDARD_SALES | COMMERCIAL_FULL
  pricingPhase       String?         @default("CASH") @db.VarChar(50) // CASH | SEASONAL | ADVANCE_BOOKING | VD | NET_RATE
  commercialCondition String?        @db.VarChar(255)
  isDeliveryChallan  Boolean         @default(false)
  batchNumber        String?         @db.VarChar(100)
  cartons            Int?
  schemeDescription  String?         @db.VarChar(255)

  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  organization       Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  salesOrder         SalesOrder?     @relation(fields: [salesOrderId], references: [id], onDelete: SetNull)
  dealer             Dealer          @relation(fields: [dealerId], references: [id], onDelete: Restrict)
  warehouse          Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  salesOfficer       User?           @relation("SalesInvoiceOfficer", fields: [salesOfficerId], references: [id], onDelete: SetNull)
  territory          Territory?      @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  zone               Zone?           @relation(fields: [zoneId], references: [id], onDelete: SetNull)
  areaManager        User?           @relation("SalesInvoiceAreaManager", fields: [areaManagerId], references: [id], onDelete: SetNull)
  region             Region?         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  businessManager    User?           @relation("SalesInvoiceBusinessManager", fields: [businessManagerId], references: [id], onDelete: SetNull)

  items              SalesInvoiceItem[]
  stockLedgerEntries StockLedgerEntry[]
  dealerLedgerEntries DealerLedgerEntry[]
  salesReturns       SalesReturn[]
  gatePasses         GatePass[]

  @@unique([companyId, invoiceNumber])
  @@index([organizationId])
  @@index([companyId, postingStatus])
  @@index([dealerId])
  @@index([salesOfficerId])
  @@index([territoryId])
  @@index([zoneId])
  @@index([areaManagerId])
  @@index([regionId])
  @@index([businessManagerId])
  @@index([postingStatus, isDeliveryChallan, invoiceDate])
  @@map("sales_invoices")
}

