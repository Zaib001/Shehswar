  packingMaterialId       String?         @db.Uuid
  quantity                Decimal         @db.Decimal(18, 6)
  uomId                   String?         @db.Uuid
  expectedWastagePercent  Decimal         @default(0) @db.Decimal(5, 2)
  notes                   String?         @db.VarChar(255)
  sortOrder               Int             @default(0)
  createdAt               DateTime        @default(now()) @db.Timestamptz(6)

  formula                 FormulaBom      @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  rawMaterial             RawMaterial?    @relation(fields: [rawMaterialId], references: [id], onDelete: Restrict)
  packingMaterial         PackingMaterial? @relation(fields: [packingMaterialId], references: [id], onDelete: Restrict)
  uom                     UnitOfMeasure?  @relation(fields: [uomId], references: [id], onDelete: Restrict)

  @@index([formulaId])
  @@map("formula_bom_components")
}

// ==========================================
