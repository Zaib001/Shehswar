  bankName               String?                         @db.VarChar(100)
  branchName             String?                         @db.VarChar(100)
  totalAmount            Decimal                         @db.Decimal(18, 2)
  totalAmountInWords     String?                         @db.VarChar(255)
  allocatedAmount        Decimal                         @default(0) @db.Decimal(18, 2)
  unallocatedAmount      Decimal                         @db.Decimal(18, 2)
  allocationStatus       String                          @default("UNALLOCATED") @db.VarChar(50) // UNALLOCATED, PARTIALLY_ALLOCATED, FULLY_ALLOCATED
  status                 String                          @default("DRAFT") @db.VarChar(50) // DRAFT, PENDING_ALLOCATION, POSTED, REVERSED, CANCELLED
  remarks                String?                         @db.Text
  attachmentUrl          String?                         @db.Text
  journalEntryId         String?                         @db.Uuid
  bankAccountId          String?                         @db.Uuid
  createdById            String?                         @db.VarChar(100)
  postedById             String?                         @db.VarChar(100)
  postedAt               DateTime?                       @db.Timestamptz(6)
  reversedById           String?                         @db.VarChar(100)
  reversedAt             DateTime?                       @db.Timestamptz(6)
  reversalReason         String?                         @db.Text
  createdAt              DateTime                        @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime                        @updatedAt @db.Timestamptz(6)

  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                Company                         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  dealer                 Dealer?                         @relation(fields: [partyDealerId], references: [id], onDelete: SetNull)
  region                 Region?                         @relation(fields: [regionId], references: [id], onDelete: SetNull)
  territory              Territory?                      @relation(fields: [territoryId], references: [id], onDelete: SetNull)
  bankAccount            BankAccount?                    @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  products               ProvisionalReceiptProduct[]
  allocations            ProvisionalReceiptAllocation[]

  @@unique([companyId, prNumber])
  @@index([organizationId])
  @@index([companyId, receiptDate])
  @@index([status])
  @@index([allocationStatus])
  @@map("provisional_receipts")
}

model ProvisionalReceiptProduct {
  id                   String             @id @default(uuid()) @db.Uuid
  provisionalReceiptId String             @db.Uuid
  srNo                 Int
  finishedProductId    String?            @db.Uuid
  productName          String             @db.VarChar(200)
  packSize             String             @db.VarChar(100)
  quantity             Decimal            @db.Decimal(18, 4)
  policyRate           Decimal            @db.Decimal(18, 4)
  amount               Decimal            @db.Decimal(18, 2) // quantity * policyRate
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)

  provisionalReceipt   ProvisionalReceipt @relation(fields: [provisionalReceiptId], references: [id], onDelete: Cascade)
  finishedProduct      FinishedProduct?   @relation(fields: [finishedProductId], references: [id], onDelete: SetNull)

  @@index([provisionalReceiptId])
  @@map("provisional_receipt_products")
}

model ProvisionalReceiptAllocation {
  id                   String             @id @default(uuid()) @db.Uuid
  provisionalReceiptId String             @db.Uuid
  dealerId             String             @db.Uuid
  partyCode            String?            @db.VarChar(50)
  dealerName           String?            @db.VarChar(200)
  regionId             String?            @db.Uuid
  territoryId          String?            @db.Uuid
  allocatedAmount      Decimal            @db.Decimal(18, 2)
  reference            String?            @db.VarChar(100)
  remarks              String?            @db.Text
  status               String             @default("POSTED") @db.VarChar(50) // POSTED, REVERSED
  dealerLedgerEntryId  String?            @db.Uuid
  journalEntryId       String?            @db.Uuid
  createdAt            DateTime           @default(now()) @db.Timestamptz(6)

  provisionalReceipt   ProvisionalReceipt @relation(fields: [provisionalReceiptId], references: [id], onDelete: Cascade)
  dealer               Dealer             @relation(fields: [dealerId], references: [id], onDelete: Restrict)

  @@index([provisionalReceiptId])
  @@index([dealerId])
  @@map("provisional_receipt_allocations")
}

// ==========================================
// 17. EMPLOYEE COST POLICY & CONTROL
// ==========================================

model EmployeeCostPolicy {
  id                         String       @id @default(uuid()) @db.Uuid
  organizationId             String       @db.Uuid
  companyId                  String       @db.Uuid
  employeeId                 String?      @db.Uuid
  roleScope                  String       @default("SALES_OFFICER") @db.VarChar(50) // ALL, SALES_OFFICER, AREA_MANAGER, BUSINESS_MANAGER, OTHER
  maximumCostPercentage      Decimal      @default(13.00) @db.Decimal(5, 2) // e.g. 13.00%
  nearLimitThresholdPercent  Decimal      @default(85.00) @db.Decimal(5, 2) // e.g. 85.00% of max, or custom near limit
  blockingAction             String       @default("APPROVAL_REQUIRED") @db.VarChar(50) // BLOCK, APPROVAL_REQUIRED, WARNING_ONLY
  effectiveFrom              DateTime     @default(now()) @db.Timestamptz(6)
  effectiveTo                DateTime?    @db.Timestamptz(6)
  status                     String       @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE
  notes                      String?      @db.Text
  createdById                String?      @db.VarChar(100)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(6)

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee                   Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([companyId, roleScope, status])
  @@index([companyId, employeeId])
  @@map("employee_cost_policies")
}

model ExpenseCategoryPolicy {
  id                         String       @id @default(uuid()) @db.Uuid
  organizationId             String       @db.Uuid
  companyId                  String       @db.Uuid
  categoryKey                String       @db.VarChar(100) // FUEL, TRAVEL, MEALS, ACCOMMODATION, DAILY_ALLOWANCE, VEHICLE_BEARING, VEHICLE_MAINTENANCE, BUILDING_REPAIR, OTHER
  categoryName               String       @db.VarChar(200)
  isEmployeeCost             Boolean      @default(true)  // Contributes to Employee Cost calculation
  isAssetExpense             Boolean      @default(false) // Company vehicle or asset expense
  description                String?      @db.Text
  status                     String       @default("ACTIVE") @db.VarChar(50)
  createdById                String?      @db.VarChar(100)
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt                  DateTime     @updatedAt @db.Timestamptz(6)

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, categoryKey])
  @@index([organizationId])
  @@index([companyId, isEmployeeCost])
  @@map("expense_category_policies")
}

model EmployeeExpenseAudit {
  id                         String       @id @default(uuid()) @db.Uuid
  organizationId             String       @db.Uuid
  companyId                  String       @db.Uuid
  employeeId                 String       @db.Uuid
  expenseType                String       @db.VarChar(50) // VEHICLE_EXPENSE, GENERAL_EXPENSE
  expenseId                  String?      @db.Uuid
  voucherNumber              String?      @db.VarChar(50)
  currentSales               Decimal      @db.Decimal(18, 2)
  currentCost                Decimal      @db.Decimal(18, 2)
  currentCostPercentage      Decimal      @db.Decimal(5, 2)
  maximumPercentage          Decimal      @db.Decimal(5, 2)
  requestedAmount            Decimal      @db.Decimal(18, 2)
  projectedCost              Decimal      @db.Decimal(18, 2)
  projectedCostPercentage    Decimal      @db.Decimal(5, 2)
  decision                   String       @db.VarChar(50) // WITHIN_LIMIT, NEAR_LIMIT, LIMIT_REACHED, LIMIT_EXCEEDED, APPROVED, OVERRIDDEN, REJECTED, BLOCKED
  approvedById               String?      @db.VarChar(100)
  approvedAt                 DateTime?    @db.Timestamptz(6)
  reason                     String?      @db.Text
  createdAt                  DateTime     @default(now()) @db.Timestamptz(6)

  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                    Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee                   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([companyId, employeeId])
  @@index([decision])
  @@map("employee_expense_audits")
}

// ==========================================
// 19. BANK ACCOUNTS MASTER
// ==========================================

model BankAccount {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @db.Uuid
  companyId          String       @db.Uuid
  bankName           String       @db.VarChar(100) // HBL, UBL, Bank Alfalah, Meezan Bank, etc.
  accountTitle       String       @db.VarChar(200) // e.g. "Shehswar Main Operations"
  accountNumber      String       @db.VarChar(100) // e.g. "PK00HABB0001234567890"
  branchName         String?      @db.VarChar(150)
  branchCode         String?      @db.VarChar(50)
  iban               String?      @db.VarChar(50)
  swiftCode          String?      @db.VarChar(50)
  currency           String       @default("PKR") @db.VarChar(10)
  openingBalance     Decimal      @default(0) @db.Decimal(18, 2)
  currentBalance     Decimal      @default(0) @db.Decimal(18, 2)
  glAccountId        String?      @db.Uuid
  isActive           Boolean      @default(true)
  notes              String?      @db.Text
  createdAt          DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime     @updatedAt @db.Timestamptz(6)

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  financialTransactions FinancialTransaction[]
  provisionalReceipts   ProvisionalReceipt[]

  @@unique([companyId, accountNumber])
  @@index([organizationId])
  @@index([companyId, bankName])
  @@map("bank_accounts")
}


