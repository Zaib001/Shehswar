// SHEHSWAR ONE360 - Database Architecture Schema
// Enterprise ERP & CRM Multi-Company / Multi-Tenant Ready Foundation

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// 1. TENANCY & ORGANIZATIONAL HIERARCHY
// ==========================================

model PlatformTenant {
  id            String         @id @default(uuid()) @db.Uuid
  code          String         @unique @db.VarChar(50)
  name          String         @db.VarChar(200)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)
  deletedAt     DateTime?      @db.Timestamptz(6)

  organizations Organization[]

  @@map("platform_tenants")
}

model Organization {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @db.Uuid
  code             String          @unique @db.VarChar(50)
  name             String          @db.VarChar(200) // e.g. "Shehswar Group"
  legalName        String?         @db.VarChar(200)
  taxId            String?         @db.VarChar(50) // NTN / Corporate Tax Registration
  strnId           String?         @db.VarChar(50) // Sales Tax Registration Number
  logoUrl          String?         @db.VarChar(500)
  industry         String?         @db.VarChar(100)
  country          String          @default("Pakistan") @db.VarChar(100)
  currency         String          @default("PKR") @db.VarChar(10)
  timezone         String          @default("Asia/Karachi") @db.VarChar(50)
  email            String?         @db.VarChar(255)
  phone            String?         @db.VarChar(50)
  address          String?         @db.Text
  createdBy        String?         @db.VarChar(100)
  isActive         Boolean         @default(true)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?       @db.Timestamptz(6)

  tenant           PlatformTenant  @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  companies        Company[]
  employees        Employee[]
  users            User[]
  roles            Role[]
  settings         SystemSetting[]
  documentSequences DocumentSequence[]
  approvalRules    ApprovalRule[]
  userMarketAssignments UserMarketAssignment[]
  vendors          Vendor[]
  purchaseRequisitions PurchaseRequisition[]
  rfqs             RequestForQuotation[]
  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  rawMaterials     RawMaterial[]
  packingMaterials PackingMaterial[]
  finishedProducts FinishedProduct[]
  materialCategories MaterialCategory[]
  dealers          Dealer[]
  purchases        PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  dealerPayments   DealerPaymentReceipt[]
  vendorPayments   VendorPayment[]
  warehouseStocks  WarehouseStock[]
  stockLedgerEntries StockLedgerEntry[]
  dealerLedgerEntries DealerLedgerEntry[]
  vendorLedgerEntries VendorLedgerEntry[]
  gatePasses       GatePass[]
  documentExtractions DocumentExtractionRecord[]
  productRateLists ProductRateList[]
  pricingAuthorityLimits PricingAuthorityLimit[]
  rateLists        RateList[]
  pricingSchemes   PricingScheme[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  expenseEntries   ExpenseEntry[]
  creditLimits     CreditLimit[]
  creditOverrideRequests CreditOverrideRequest[]
  salesTargets     SalesTarget[]
  vehicles         Vehicle[]
  vehicleAssignments VehicleAssignment[]
  vehicleExpenses  VehicleExpense[]
  salaryPayments   EmployeeSalaryPayment[]
  financialTransactions FinancialTransaction[]
  provisionalReceipts ProvisionalReceipt[]
  employeeCostPolicies EmployeeCostPolicy[]
  expenseCategoryPolicies ExpenseCategoryPolicy[]
  employeeExpenseAudits EmployeeExpenseAudit[]
  bankAccounts     BankAccount[]

  @@index([tenantId])
  @@map("organizations")
}

model Company {
  id               String          @id @default(uuid()) @db.Uuid
  organizationId   String          @db.Uuid
  parentCompanyId  String?         @db.Uuid // Self-referential FK for parent/child hierarchy
  code             String          @db.VarChar(50)
  name             String          @db.VarChar(200)
  legalName        String?         @db.VarChar(200)
  // PARENT_MANUFACTURING | CHILD_COMPANY | TRADING | DISTRIBUTION
  companyType      String          @default("PARENT_MANUFACTURING") @db.VarChar(50)
  isParent         Boolean         @default(false)
  taxId            String?         @db.VarChar(50) // NTN / STRN — only if confirmed
  strnId           String?         @db.VarChar(50) // STRN — only if confirmed
  currencyCode     String          @default("PKR") @db.VarChar(10)
  financialYear    String?         @db.VarChar(10) // e.g. "2026"
  email            String?         @db.VarChar(255)
  phone            String?         @db.VarChar(50)
  address          String?         @db.Text
  managerName      String?         @db.VarChar(100)
  isActive         Boolean         @default(true)
  status           String          @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE, ARCHIVED
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?       @db.Timestamptz(6)

  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentCompany    Company?        @relation("CompanyHierarchy", fields: [parentCompanyId], references: [id], onDelete: Restrict)
  childCompanies   Company[]       @relation("CompanyHierarchy")
  plants           Plant[]
  branches         Branch[]
  departments      Department[]
  warehouses       Warehouse[]
  employees        Employee[]
  regions          Region[]
  users            User[]
  userRoles        UserRole[]
  userMarketAssignments UserMarketAssignment[]
  documentSequences DocumentSequence[]
  settings         SystemSetting[]
  vendors          Vendor[]
  purchaseRequisitions PurchaseRequisition[]
  rfqs             RequestForQuotation[]
  vendorQuotations VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  vendorPerformances VendorPerformance[]
  rawMaterials     RawMaterial[]
  packingMaterials PackingMaterial[]
  finishedProducts FinishedProduct[]
  taxCategories    TaxCategory[]
  paymentTerms     PaymentTerm[]
  productionLines  ProductionLine[]
  shifts           Shift[]
  icPricingRulesSource IntercompanyPricingRule[] @relation("IcSourceCompany")
  icPricingRulesTarget IntercompanyPricingRule[] @relation("IcTargetCompany")
  dealers          Dealer[]
  purchases        PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  salesOrders      SalesOrder[]
  salesInvoices    SalesInvoice[]
  salesReturns     SalesReturn[]
  dealerPayments   DealerPaymentReceipt[]
  vendorPayments   VendorPayment[]
  warehouseStocks  WarehouseStock[]
  stockLedgerEntries StockLedgerEntry[]
  dealerLedgerEntries DealerLedgerEntry[]
  vendorLedgerEntries VendorLedgerEntry[]
  gatePasses       GatePass[]
  documentExtractions DocumentExtractionRecord[]
  productRateLists ProductRateList[]
  pricingAuthorityLimits PricingAuthorityLimit[]
  rateLists        RateList[]
  pricingSchemes   PricingScheme[]
  accounts         Account[]
  journalEntries   JournalEntry[]
  expenseEntries   ExpenseEntry[]
  creditLimits     CreditLimit[]
  creditOverrideRequests CreditOverrideRequest[]
  salesTargets     SalesTarget[]
  vehicles         Vehicle[]
  vehicleAssignments VehicleAssignment[]
  vehicleExpenses  VehicleExpense[]
  salaryPayments   EmployeeSalaryPayment[]
  financialTransactions FinancialTransaction[]
  provisionalReceipts ProvisionalReceipt[]
  employeeCostPolicies EmployeeCostPolicy[]
  expenseCategoryPolicies ExpenseCategoryPolicy[]
  employeeExpenseAudits EmployeeExpenseAudit[]
  bankAccounts     BankAccount[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([parentCompanyId])
  @@map("companies")
}

model Plant {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  code        String      @db.VarChar(50)
  name        String      @db.VarChar(200) // e.g. "Main Manufacturing Plant"
  location    String?     @db.VarChar(255)
  address     String?     @db.Text
  managerName String?     @db.VarChar(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouses  Warehouse[]
  employees   Employee[]
  userRoles   UserRole[]
  productionLines ProductionLine[]
  shifts      Shift[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("plants")
}

model Branch {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  code        String      @db.VarChar(50)
  name        String      @db.VarChar(200) // e.g. "Lahore Regional Office"
  address     String?     @db.VarChar(255)
  city        String?     @db.VarChar(100)
  regionName  String?     @db.VarChar(100)
  managerName String?     @db.VarChar(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  warehouses  Warehouse[]
  employees   Employee[]
  userRoles   UserRole[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("branches")
}

model Department {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  code        String      @db.VarChar(50)
  name        String      @db.VarChar(100) // e.g. "Procurement", "Quality Assurance", "Finance"
  managerName String?     @db.VarChar(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employees   Employee[]
  purchaseRequisitions PurchaseRequisition[]
  purchaseOrders PurchaseOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("departments")
}

model Warehouse {
  id          String      @id @default(uuid()) @db.Uuid
  companyId   String      @db.Uuid
  plantId     String?     @db.Uuid
  branchId    String?     @db.Uuid
  code        String      @db.VarChar(50)
  name        String      @db.VarChar(200) // e.g. "Raw Materials Warehouse", "Finished Goods Central"
  type        String      @default("GENERAL") @db.VarChar(50) // RAW_MATERIAL, FINISHED_GOODS, TRANSIT, QUARANTINE, PACKING_MATERIAL, RETURNS
  location    String?     @db.VarChar(255)
  address     String?     @db.Text
  managerName String?     @db.VarChar(100)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime    @updatedAt @db.Timestamptz(6)

  company     Company     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant       Plant?      @relation(fields: [plantId], references: [id], onDelete: Restrict)
  branch      Branch?     @relation(fields: [branchId], references: [id], onDelete: Restrict)
  purchaseOrders PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  warehouseLocations WarehouseLocation[]
  purchases          PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  salesOrders        SalesOrder[]
  salesInvoices      SalesInvoice[]
  salesReturns       SalesReturn[]
  warehouseStocks    WarehouseStock[]
  stockLedgerEntries StockLedgerEntry[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([plantId])
  @@index([branchId])
  @@map("warehouses")
}

model Region {
  id              String         @id @default(uuid()) @db.Uuid
  companyId       String         @db.Uuid
  code            String         @db.VarChar(50)
  name            String         @db.VarChar(100) // e.g. "Punjab Region"
  managerId       String?        @db.Uuid // Business Manager (BM)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(6)

  company         Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  businessManager User?          @relation("RegionBusinessManager", fields: [managerId], references: [id], onDelete: SetNull)
  zones           Zone[]
  salesInvoices   SalesInvoice[]
  salesOrders     SalesOrder[]
  userMarketAssignments UserMarketAssignment[]
  provisionalReceipts ProvisionalReceipt[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([managerId])
  @@map("regions")
}

model Zone {
  id            String         @id @default(uuid()) @db.Uuid
  regionId      String         @db.Uuid
  code          String         @db.VarChar(50)
  name          String         @db.VarChar(100) // e.g. "North Punjab Zone"
  managerId     String?        @db.Uuid // Area Manager (AM)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  region        Region         @relation(fields: [regionId], references: [id], onDelete: Restrict)
  areaManager   User?          @relation("ZoneAreaManager", fields: [managerId], references: [id], onDelete: SetNull)
  territories   Territory[]
  salesInvoices SalesInvoice[]
  salesOrders   SalesOrder[]
  userMarketAssignments UserMarketAssignment[]

  @@unique([regionId, code])
  @@index([regionId])
  @@index([managerId])
  @@map("zones")
}

model Territory {
  id            String         @id @default(uuid()) @db.Uuid
  zoneId        String         @db.Uuid
  code          String         @db.VarChar(50)
  name          String         @db.VarChar(100) // e.g. "Gujranwala City Territory"
  managerId     String?        @db.Uuid // Primary Sales Officer (SO)
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime       @updatedAt @db.Timestamptz(6)

  zone          Zone           @relation(fields: [zoneId], references: [id], onDelete: Restrict)
  salesOfficer  User?          @relation("TerritorySalesOfficer", fields: [managerId], references: [id], onDelete: SetNull)
  dealers       Dealer[]
  salesInvoices SalesInvoice[]
  salesOrders   SalesOrder[]
  userMarketAssignments UserMarketAssignment[]
  dealerAssignmentHistories DealerAssignmentHistory[]
  provisionalReceipts ProvisionalReceipt[]

  @@unique([zoneId, code])
  @@index([zoneId])
  @@index([managerId])
  @@map("territories")
}

model Employee {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  companyId      String       @db.Uuid
  departmentId   String?      @db.Uuid
  plantId        String?      @db.Uuid
  branchId       String?      @db.Uuid
  employeeCode   String       @db.VarChar(50)
  firstName      String       @db.VarChar(100)
  lastName       String       @db.VarChar(100)
  fatherName     String?      @db.VarChar(100)
  cnic           String?      @db.VarChar(50)
  licenseNumber  String?      @db.VarChar(100)
  address        String?      @db.Text
  agencyType     String?      @db.VarChar(100) // PERMANENT, CONTRACT, THIRD_PARTY, FIELD_STAFF
  salary         Decimal?     @default(0) @db.Decimal(18, 2)
  phone          String?      @db.VarChar(50)
  email          String?      @db.VarChar(255)
  position       String       @db.VarChar(100)
  joiningDate    DateTime     @default(now()) @db.Timestamptz(6)
  resignationDate DateTime?   @db.Timestamptz(6)
  terminationDate DateTime?   @db.Timestamptz(6)
  status         String       @default("ACTIVE") @db.VarChar(50) // ACTIVE, RESIGNED, TERMINATED, INACTIVE
  managerId      String?      @db.Uuid
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department     Department?  @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  branch         Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)
  manager        Employee?    @relation("EmployeeManager", fields: [managerId], references: [id], onDelete: SetNull)
  subordinates   Employee[]   @relation("EmployeeManager")
  users          User[]
  marketAssignments UserMarketAssignment[]
  currentVehicles Vehicle[]    @relation("CurrentVehicleCustodian")
  vehicleAssignments VehicleAssignment[] @relation("EmployeeVehicleAssignments")
  vehicleExpenses VehicleExpense[] @relation("EmployeeVehicleExpenses")
  salaryPayments EmployeeSalaryPayment[] @relation("EmployeeSalaryPayments")
  expenses       ExpenseEntry[]          @relation("EmployeeGeneralExpenses")
  expenseAudits  EmployeeExpenseAudit[]
  costPolicies   EmployeeCostPolicy[]

  @@unique([companyId, employeeCode])
  @@index([organizationId])
  @@index([companyId])
  @@map("employees")
}

// ==========================================
// 2. IDENTITY, ACCESS & RBAC
// ==========================================

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  companyId           String               @db.Uuid
  employeeId          String?              @db.Uuid
  email               String               @unique @db.VarChar(255)
  passwordHash        String               @db.VarChar(255)
  firstName           String               @db.VarChar(100)
  lastName            String               @db.VarChar(100)
  phone               String?              @db.VarChar(50)
  status              String               @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE, SUSPENDED, LOCKED
  isSuperAdmin        Boolean              @default(false)
  isActive            Boolean              @default(true)
  failedLoginAttempts Int                  @default(0)
  lockedUntil         DateTime?            @db.Timestamptz(6)
  lastLoginAt         DateTime?            @db.Timestamptz(6)
  passwordChangedAt   DateTime             @default(now()) @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)
  deletedAt           DateTime?            @db.Timestamptz(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  employee            Employee?            @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  userRoles           UserRole[]
  sessions            UserSession[]
  passwordResets      PasswordResetToken[]
  notifications       UserNotification[]
  salesOfficerAssignments SalesOfficerDealerAssignment[]
  assignedSalesOrders SalesOrder[]
  dealerPayments      DealerPaymentReceipt[]
  managedRegions      Region[]             @relation("RegionBusinessManager")
  managedZones        Zone[]               @relation("ZoneAreaManager")
  managedTerritories  Territory[]          @relation("TerritorySalesOfficer")
  assignedDealers     Dealer[]             @relation("DealerAssignedOfficer")
  salesOfficerInvoices SalesInvoice[]      @relation("SalesInvoiceOfficer")
  areaManagerInvoices SalesInvoice[]       @relation("SalesInvoiceAreaManager")
  businessManagerInvoices SalesInvoice[]   @relation("SalesInvoiceBusinessManager")
  marketAssignments   UserMarketAssignment[]
  dealerAssignmentHistories DealerAssignmentHistory[]
  areaManagerOrders   SalesOrder[]         @relation("SalesOrderAreaManager")
  businessManagerOrders SalesOrder[]       @relation("SalesOrderBusinessManager")

  @@index([organizationId])
  @@index([companyId])
  @@index([email])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  organizationId  String           @db.Uuid
  code            String           @db.VarChar(50)
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(6)

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  resource        String           @db.VarChar(100) // e.g. "sales_order", "costing"
  action          String           @db.VarChar(100) // e.g. "view", "approve", "view_cost"
  code            String           @unique @db.VarChar(150) // e.g. "sales_order:view"
  description     String?          @db.VarChar(255)
  isSensitive     Boolean          @default(false)
  createdAt       DateTime         @default(now()) @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@index([resource, action])
  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  createdAt    DateTime   @default(now()) @db.Timestamptz(6)

  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  roleId    String   @db.Uuid
  companyId String?  @db.Uuid
  plantId   String?  @db.Uuid
  branchId  String?  @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  company   Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)
  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@index([companyId])
  @@map("user_roles")
}

model UserSession {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @db.Uuid
  tokenHash    String    @unique @db.VarChar(255)
  userAgent    String?   @db.VarChar(500)
  ipAddress    String?   @db.VarChar(50)
  isRevoked    Boolean   @default(false)
  lastActiveAt DateTime  @default(now()) @db.Timestamptz(6)
  expiresAt    DateTime  @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @db.Timestamptz(6)

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
  @@map("user_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique @db.VarChar(255)
  isUsed    Boolean   @default(false)
  expiresAt DateTime  @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("password_reset_tokens")
}

// ==========================================
// 3. AUDIT & EVENT ARCHITECTURE (IMMUTABLE)
// ==========================================

model AuditLog {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String?   @db.Uuid
  actorId        String    @db.Uuid
  actorEmail     String?   @db.VarChar(255)
  resource       String    @db.VarChar(100)
  resourceId     String    @db.VarChar(100)
  action         String    @db.VarChar(100)
  previousState  Json?
  newState       Json?
  changedFields  String[]  @db.VarChar(100)
  correlationId  String    @db.VarChar(100)
  ipAddress      String?   @db.VarChar(50)
  userAgent      String?   @db.VarChar(500)
  metadata       Json?
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId, createdAt])
  @@index([companyId, createdAt])
  @@index([resource, resourceId])
  @@index([actorId, createdAt])
  @@index([correlationId])
  @@map("audit_logs")
}

model DomainEventOutbox {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String?   @db.Uuid
  actorId        String?   @db.Uuid
  eventName      String    @db.VarChar(150)
  eventVersion   Int       @default(1)
  aggregateType  String    @db.VarChar(100)
  aggregateId    String    @db.VarChar(100)
  payload        Json
  correlationId  String    @db.VarChar(100)
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, PROCESSING, PUBLISHED, FAILED
  retryCount     Int       @default(0)
  nextRetryAt    DateTime? @db.Timestamptz(6)
  lockedAt       DateTime? @db.Timestamptz(6)
  lockedBy       String?   @db.VarChar(100)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  processedAt    DateTime? @db.Timestamptz(6)

  @@index([status, nextRetryAt, createdAt])
  @@index([organizationId])
  @@index([correlationId])
  @@map("domain_event_outbox")
}

model IdempotencyRecord {
  id             String    @id @default(uuid()) @db.Uuid
  key            String    @db.VarChar(255)
  organizationId String    @db.Uuid
  userId         String?   @db.Uuid
  endpoint       String    @db.VarChar(255)
  requestHash    String    @db.VarChar(64) // SHA-256 hash of the request body
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, COMPLETED, FAILED
  responseStatus Int?      // HTTP status code (e.g. 200, 201)
  responseBody   Json?     // Stored replay response
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)
  expiresAt      DateTime  @db.Timestamptz(6)

  @@unique([organizationId, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// ==========================================
// 4. DOCUMENT NUMBERING & SEQUENCING
// ==========================================

model DocumentSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  companyId      String       @db.Uuid
  documentType   String       @db.VarChar(50) // PO, GRN, SO, INVOICE, BATCH
  fiscalYear     Int          @db.Integer    // e.g. 2026
  prefix         String       @db.VarChar(20) // e.g. "SH-PO-2026"
  currentNumber  BigInt       @default(0)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company        Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, documentType, fiscalYear])
  @@index([organizationId])
  @@map("document_sequences")
}

// ==========================================
// 5. CONFIGURATION & FEATURE FLAGS
// ==========================================

model SystemSetting {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @db.Uuid
  companyId      String?       @db.Uuid
  scope          String        @db.VarChar(50) // PLATFORM, ORGANIZATION, COMPANY, BRANCH
  scopeId        String?       @db.Uuid
  key            String        @db.VarChar(100)
  value          Json
  isEncrypted    Boolean       @default(false)
  createdAt      DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @db.Timestamptz(6)

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  company        Company?      @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([scope, key, scopeId])
  @@index([key])
  @@map("system_settings")
}

model FeatureFlag {
  id                 String                @id @default(uuid()) @db.Uuid
  key                String                @unique @db.VarChar(100)
  name               String                @db.VarChar(150)
  description        String?               @db.VarChar(255)
  isEnabledGlobally  Boolean               @default(false)
  createdAt          DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime              @updatedAt @db.Timestamptz(6)

  overrides          FeatureFlagOverride[]

  @@map("feature_flags")
}

model FeatureFlagOverride {
  id             String       @id @default(uuid()) @db.Uuid
  flagId         String       @db.Uuid
  organizationId String?      @db.Uuid
  companyId      String?      @db.Uuid
  isEnabled      Boolean      @default(false)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  flag           FeatureFlag  @relation(fields: [flagId], references: [id], onDelete: Cascade)

  @@unique([flagId, organizationId, companyId])
  @@index([flagId])
  @@map("feature_flag_overrides")
}

// ==========================================
// 6. OBJECT STORAGE & ATTACHMENTS
// ==========================================

model FileMetadata {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  companyId        String?   @db.Uuid
  provider         String    @db.VarChar(50) // S3, R2, MINIO, LOCAL
  storageKey       String    @unique @db.VarChar(500)
  bucket           String    @db.VarChar(100)
  originalFileName String    @db.VarChar(255)
  mimeType         String    @db.VarChar(100)
  fileSizeBytes    BigInt
  sha256Hash       String    @db.VarChar(64)
  classification   String    @default("INTERNAL") @db.VarChar(50) // PUBLIC, INTERNAL, CONFIDENTIAL, HIGHLY_SENSITIVE
  entityType       String?   @db.VarChar(100) // "purchase_order", "qc_report", etc.
  entityId         String?   @db.VarChar(100)
  uploadedById     String    @db.Uuid
  isArchived       Boolean   @default(false)
  createdAt        DateTime  @default(now()) @db.Timestamptz(6)

  @@index([organizationId, entityType, entityId])
  @@index([companyId])
  @@index([uploadedById])
  @@map("file_metadata")
}

// ==========================================
// 7. APPROVAL WORKFLOW ENGINE
// ==========================================

model ApprovalRule {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  companyId      String?      @db.Uuid
  documentType   String       @db.VarChar(50) // PO, SO, PROD_ORDER, FORMULA
  minAmount      Decimal?     @db.Decimal(18, 2)
  maxAmount      Decimal?     @db.Decimal(18, 2)
  ruleConfig     Json         // Levels, roles, conditions
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([organizationId, documentType])
  @@map("approval_rules")
}

model ApprovalRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  companyId      String            @db.Uuid
  documentType   String            @db.VarChar(50)
  documentId     String            @db.VarChar(100)
  status         String            @default("PENDING_APPROVAL") @db.VarChar(50)
  currentLevel   Int               @default(1)
  totalLevels    Int               @default(1)
  requestedById  String            @db.Uuid
  createdAt      DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @db.Timestamptz(6)

  history        ApprovalHistory[]

  @@unique([documentType, documentId])
  @@index([organizationId, status])
  @@index([companyId])
  @@map("approval_requests")
}

model ApprovalHistory {
  id          String          @id @default(uuid()) @db.Uuid
  requestId   String          @db.Uuid
  actorId     String          @db.Uuid
  action      String          @db.VarChar(50) // APPROVED, REJECTED, SENT_BACK
  level       Int
  comments    String?         @db.Text
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)

  request     ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("approval_history")
}

// ==========================================
// 8. NOTIFICATION ENGINE
// ==========================================

model NotificationTemplate {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique @db.VarChar(100) // e.g. "PO_APPROVED_NOTIF"
  channel      String   @db.VarChar(50) // IN_APP, EMAIL, SMS, WHATSAPP
  subject      String?  @db.VarChar(255)
  bodyTemplate String   @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)

  @@map("notification_templates")
}

model NotificationQueueItem {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  companyId      String?   @db.Uuid
  recipientId    String    @db.Uuid
  channel        String    @db.VarChar(50)
  title          String    @db.VarChar(255)
  body           String    @db.Text
  payload        Json?
  status         String    @default("PENDING") @db.VarChar(50) // PENDING, SENT, FAILED
  retryCount     Int       @default(0)
  lastError      String?   @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  sentAt         DateTime? @db.Timestamptz(6)

  @@index([status, createdAt])
  @@index([recipientId])
