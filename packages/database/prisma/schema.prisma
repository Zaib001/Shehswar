model UserNotification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  title     String    @db.VarChar(255)
  body      String    @db.Text
  linkUrl   String?   @db.VarChar(500)
  category  String    @default("SYSTEM") @db.VarChar(50) // APPROVAL, SYSTEM, SECURITY, WARNING
  priority  String    @default("NORMAL") @db.VarChar(50) // LOW, NORMAL, HIGH, URGENT
  isRead    Boolean   @default(false)
  readAt    DateTime? @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("user_notifications")
}

// ==========================================
// 9. PROCUREMENT & VENDOR MANAGEMENT
// ==========================================

model Vendor {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  companyId        String            @db.Uuid
  code             String            @db.VarChar(50)
  name             String            @db.VarChar(200)
  legalName        String?           @db.VarChar(200)
  vendorType       String            @default("RAW_MATERIAL") @db.VarChar(50) // RAW_MATERIAL, PACKING_MATERIAL, SERVICE, TRANSPORT, MACHINERY
  category         String            @default("GENERAL") @db.VarChar(100)
  status           String            @default("DRAFT") @db.VarChar(50) // DRAFT, PENDING_APPROVAL, APPROVED, BLOCKED, INACTIVE

  // Registration Information
  ntn              String?           @db.VarChar(50)
  strn             String?           @db.VarChar(50)
  registrationNo   String?           @db.VarChar(100)
  country          String            @default("Pakistan") @db.VarChar(100)
  city             String?           @db.VarChar(100)
  address          String?           @db.Text

  // Contact Information
  contactPerson    String?           @db.VarChar(100)
  phone            String?           @db.VarChar(50)
  email            String?           @db.VarChar(255)
  website          String?           @db.VarChar(255)

  // Commercial Information
  currency         String            @default("PKR") @db.VarChar(10)
  paymentTerms     String            @default("30_DAYS_CREDIT") @db.VarChar(100) // ADVANCE_PAYMENT, 30_DAYS_CREDIT, 60_DAYS_CREDIT, CUSTOM_TERMS
  creditLimit      Decimal           @default(0) @db.Decimal(18, 2)
  bankDetails      Json?

  // Rating & Metadata
  rating           Decimal           @default(5.0) @db.Decimal(3, 2)
  notes            String?           @db.Text
  createdBy        String?           @db.VarChar(100)
  updatedBy        String?           @db.VarChar(100)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt        DateTime?         @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  documents        VendorDocument[]
  rfqVendors       RfqVendor[]
  quotations       VendorQuotation[]
  purchaseOrders   PurchaseOrder[]
  goodsReceiptNotes GoodsReceiptNote[]
  performances     VendorPerformance[]
  purchases          PurchaseInvoice[]
  purchaseReturns    PurchaseReturn[]
  vendorPayments     VendorPayment[]
  vendorLedgerEntries VendorLedgerEntry[]
  gatePasses         GatePass[]

  @@unique([companyId, code])
  @@index([organizationId, status])
  @@index([companyId, vendorType])
  @@map("vendors")
}

model VendorDocument {
  id               String            @id @default(uuid()) @db.Uuid
  vendorId         String            @db.Uuid
  documentType     String            @db.VarChar(50) // CONTRACT, AGREEMENT, TAX_DOC, CERTIFICATE, LICENSE
  title            String            @db.VarChar(200)
  fileName         String            @db.VarChar(255)
  fileUrl          String            @db.VarChar(500)
  fileSize         BigInt?
  expiryDate       DateTime?         @db.Date
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  vendor           Vendor            @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId])
  @@map("vendor_documents")
}

model PurchaseRequisition {
  id                   String                      @id @default(uuid()) @db.Uuid
  organizationId       String                      @db.Uuid
  companyId            String                      @db.Uuid
  departmentId         String?                     @db.Uuid
  prNumber             String                      @db.VarChar(50) // e.g. SH-PR-2026-000001
  requestedById        String                      @db.Uuid
  requestedByName      String?                     @db.VarChar(150)
  requiredDate         DateTime                    @db.Date
  priority             String                      @default("NORMAL") @db.VarChar(50) // LOW, NORMAL, HIGH, URGENT
  purpose              String                      @db.VarChar(500)
  notes                String?                     @db.Text
  status               String                      @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, PENDING_APPROVAL, APPROVED, REJECTED, CANCELLED
  totalEstimatedAmount Decimal                     @default(0) @db.Decimal(18, 2)
  approvedAt           DateTime?                   @db.Timestamptz(6)
  approvedById         String?                     @db.Uuid
  rejectionReason      String?                     @db.Text
  createdAt            DateTime                    @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?                   @db.Timestamptz(6)

  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company                     @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department           Department?                 @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  items                PurchaseRequisitionItem[]
  rfqs                 RequestForQuotation[]
  purchaseOrders       PurchaseOrder[]

  @@unique([companyId, prNumber])
  @@index([organizationId, status])
  @@index([companyId, requiredDate])
  @@map("purchase_requisitions")
}

model PurchaseRequisitionItem {
  id                       String               @id @default(uuid()) @db.Uuid
  prId                     String               @db.Uuid
  // Material Master linkage (Phase 4.5 retrofit — nullable for backward compat)
  materialId               String?              @db.Uuid // References RawMaterial or PackingMaterial id
  materialType             String?              @db.VarChar(50) // RAW_MATERIAL | PACKING_MATERIAL | SERVICE | SPARE_PART | OTHER
  uomId                    String?              @db.Uuid // References UnitOfMeasure
  // Snapshot fields — captured at save time for historical integrity
  materialCodeSnapshot     String?              @db.VarChar(100)
  materialNameSnapshot     String?              @db.VarChar(255)
  uomCodeSnapshot          String?              @db.VarChar(50)
  // Legacy / free-text (kept for backward compat)
  itemName                 String               @db.VarChar(200)
  category                 String               @default("RAW_MATERIAL") @db.VarChar(100)
  quantity                 Decimal              @db.Decimal(18, 4)
  unit                     String               @default("KG") @db.VarChar(50)
  requiredDate             DateTime             @db.Date
  specification            String?              @db.Text
  estimatedRate            Decimal              @default(0) @db.Decimal(18, 2)
  estimatedAmount          Decimal              @default(0) @db.Decimal(18, 2)
  notes                    String?              @db.Text
  createdAt                DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @db.Timestamptz(6)

  requisition              PurchaseRequisition  @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@index([prId])
  @@index([materialId])
  @@map("purchase_requisition_items")
}

model RequestForQuotation {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @db.Uuid
  companyId           String               @db.Uuid
  rfqNumber           String               @db.VarChar(50) // e.g. SH-RFQ-2026-000001
  prId                String?              @db.Uuid
  title               String               @db.VarChar(200)
  issueDate           DateTime             @default(now()) @db.Date
  deadline            DateTime             @db.Date
  status              String               @default("DRAFT") @db.VarChar(50) // DRAFT, SENT, QUOTATIONS_RECEIVED, COMPARISON_COMPLETED, CLOSED
  notes               String?              @db.Text
  createdById         String?              @db.Uuid
  createdAt           DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(6)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  requisition         PurchaseRequisition? @relation(fields: [prId], references: [id], onDelete: SetNull)
  vendors             RfqVendor[]
  quotations          VendorQuotation[]
  purchaseOrders      PurchaseOrder[]

  @@unique([companyId, rfqNumber])
  @@index([organizationId, status])
  @@map("request_for_quotations")
}

model RfqVendor {
  id              String               @id @default(uuid()) @db.Uuid
  rfqId           String               @db.Uuid
  vendorId        String               @db.Uuid
  invitedAt       DateTime             @default(now()) @db.Timestamptz(6)
  status          String               @default("INVITED") @db.VarChar(50) // INVITED, SUBMITTED, DECLINED
  notes           String?              @db.Text

  rfq             RequestForQuotation  @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor          Vendor               @relation(fields: [vendorId], references: [id], onDelete: Restrict)

  @@unique([rfqId, vendorId])
  @@index([vendorId])
  @@map("rfq_vendors")
}

model VendorQuotation {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @db.Uuid
  companyId              String                @db.Uuid
  rfqId                  String                @db.Uuid
  vendorId               String                @db.Uuid
  quotationNumber        String                @db.VarChar(100) // Vendor reference #
  currency               String                @default("PKR") @db.VarChar(10)
  subtotal               Decimal               @default(0) @db.Decimal(18, 2)
  taxAmount              Decimal               @default(0) @db.Decimal(18, 2)
  discountAmount         Decimal               @default(0) @db.Decimal(18, 2)
  netAmount              Decimal               @default(0) @db.Decimal(18, 2)
  deliveryLeadDays       Int                   @default(7)
  paymentTerms           String                @default("30_DAYS_CREDIT") @db.VarChar(100)
  validityDate           DateTime              @db.Date
  warranty               String?               @db.VarChar(200)
  notes                  String?               @db.Text
  status                 String                @default("RECEIVED") @db.VarChar(50) // RECEIVED, UNDER_REVIEW, SELECTED, REJECTED
  isSelected             Boolean               @default(false)
  selectionJustification String?               @db.Text
  selectedAt             DateTime?             @db.Timestamptz(6)
  selectedById           String?               @db.Uuid
  createdAt              DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime              @updatedAt @db.Timestamptz(6)

  organization           Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rfq                    RequestForQuotation   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  vendor                 Vendor                @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  items                  VendorQuotationItem[]

  @@unique([rfqId, vendorId, quotationNumber])
  @@index([organizationId, status])
  @@index([vendorId])
  @@map("vendor_quotations")
}

model VendorQuotationItem {
  id             String          @id @default(uuid()) @db.Uuid
  quotationId    String          @db.Uuid
  itemName       String          @db.VarChar(200)
  quantity       Decimal         @db.Decimal(18, 4)
  unit           String          @default("KG") @db.VarChar(50)
  unitPrice      Decimal         @db.Decimal(18, 2)
  taxRate        Decimal         @default(0) @db.Decimal(5, 2)
  discountRate   Decimal         @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal         @db.Decimal(18, 2)
  notes          String?         @db.Text

  quotation      VendorQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("vendor_quotation_items")
}

model PurchaseOrder {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @db.Uuid
  companyId            String                 @db.Uuid
  departmentId         String?                @db.Uuid
  vendorId             String                 @db.Uuid
  warehouseId          String?                @db.Uuid
  prId                 String?                @db.Uuid
  rfqId                String?                @db.Uuid
  poNumber             String                 @db.VarChar(50) // e.g. SH-PO-2026-000001
  currency             String                 @default("PKR") @db.VarChar(10)
  paymentTerms         String                 @default("30_DAYS_CREDIT") @db.VarChar(100)
  deliveryLocation     String?                @db.VarChar(255)
  expectedDeliveryDate DateTime?              @db.Date
  subtotal             Decimal                @default(0) @db.Decimal(18, 2)
  taxAmount            Decimal                @default(0) @db.Decimal(18, 2)
  discountAmount       Decimal                @default(0) @db.Decimal(18, 2)
  totalAmount          Decimal                @default(0) @db.Decimal(18, 2)
  status               String                 @default("DRAFT") @db.VarChar(50) // DRAFT, SUBMITTED, APPROVED, SENT_TO_VENDOR, PARTIALLY_RECEIVED, COMPLETED, CANCELLED
  createdById          String?                @db.Uuid
  approvedAt           DateTime?              @db.Timestamptz(6)
  approvedById         String?                @db.Uuid
  cancellationReason   String?                @db.Text
  notes                String?                @db.Text
  createdAt            DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?              @db.Timestamptz(6)

  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  department           Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  vendor               Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse            Warehouse?             @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  requisition          PurchaseRequisition?   @relation(fields: [prId], references: [id], onDelete: SetNull)
  rfq                  RequestForQuotation?   @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  items                PurchaseOrderItem[]
  goodsReceiptNotes    GoodsReceiptNote[]

  @@unique([companyId, poNumber])
  @@index([organizationId, status])
  @@index([vendorId])
  @@index([companyId, createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  poId                     String                 @db.Uuid
  // Material Master linkage (Phase 4.5 retrofit — nullable for backward compat)
  materialId               String?                @db.Uuid
  materialType             String?                @db.VarChar(50) // RAW_MATERIAL | PACKING_MATERIAL | SERVICE | SPARE_PART | OTHER
  uomId                    String?                @db.Uuid
  taxCategoryId            String?                @db.Uuid // References TaxCategory
  // Snapshot fields for historical document integrity
  materialCodeSnapshot     String?                @db.VarChar(100)
  materialNameSnapshot     String?                @db.VarChar(255)
  uomCodeSnapshot          String?                @db.VarChar(50)
  taxRateSnapshot          Decimal?               @db.Decimal(5, 2) // Captured at PO creation
  specificationSnapshot    String?                @db.Text
  // Legacy / working fields
  itemName                 String                 @db.VarChar(200)
  category                 String                 @default("RAW_MATERIAL") @db.VarChar(100)
  quantity                 Decimal                @db.Decimal(18, 4)
  unit                     String                 @default("KG") @db.VarChar(50)
  unitRate                 Decimal                @db.Decimal(18, 2)
  taxRate                  Decimal                @default(0) @db.Decimal(5, 2)
  taxAmount                Decimal                @default(0) @db.Decimal(18, 2)
  discountRate             Decimal                @default(0) @db.Decimal(5, 2)
  discountAmount           Decimal                @default(0) @db.Decimal(18, 2)
  lineTotal                Decimal                @db.Decimal(18, 2)
  receivedQuantity         Decimal                @default(0) @db.Decimal(18, 4)
  notes                    String?                @db.Text
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)

  order                    PurchaseOrder          @relation(fields: [poId], references: [id], onDelete: Cascade)
  grnItems                 GoodsReceiptNoteItem[]

  @@index([poId])
  @@index([materialId])
  @@map("purchase_order_items")
}

model GoodsReceiptNote {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @db.Uuid
  companyId          String                 @db.Uuid
  poId               String                 @db.Uuid
  vendorId           String                 @db.Uuid
  warehouseId        String                 @db.Uuid
  grnNumber          String                 @db.VarChar(50) // e.g. SH-GRN-2026-000001
  receivedDate       DateTime               @default(now()) @db.Date
  receivedById       String                 @db.Uuid
  receivedByName     String?                @db.VarChar(150)
  carrierName        String?                @db.VarChar(100)
  vehicleNumber      String?                @db.VarChar(50)
  deliveryNoteNumber String?                @db.VarChar(100)
  status             String                 @default("DRAFT") @db.VarChar(50) // DRAFT, RECEIVED, QUALITY_PENDING, ACCEPTED, REJECTED
  qcStatus           String                 @default("PENDING") @db.VarChar(50) // PENDING, PASSED, REJECTED, WAIVED
  qcNotes            String?                @db.Text
  notes              String?                @db.Text
  createdAt          DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(6)
  deletedAt          DateTime?              @db.Timestamptz(6)

  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  purchaseOrder      PurchaseOrder          @relation(fields: [poId], references: [id], onDelete: Restrict)
  vendor             Vendor                 @relation(fields: [vendorId], references: [id], onDelete: Restrict)
  warehouse          Warehouse              @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items              GoodsReceiptNoteItem[]

  @@unique([companyId, grnNumber])
  @@index([organizationId, status])
  @@index([poId])
  @@index([vendorId])
  @@map("goods_receipt_notes")
}

model GoodsReceiptNoteItem {
  id                       String                 @id @default(uuid()) @db.Uuid
  grnId                    String                 @db.Uuid
  poItemId                 String?                @db.Uuid
  // Material Master linkage (Phase 4.5 retrofit — nullable for backward compat)
  materialId               String?                @db.Uuid
  materialType             String?                @db.VarChar(50)
  uomId                    String?                @db.Uuid
  // Snapshot fields
  materialCodeSnapshot     String?                @db.VarChar(100)
  materialNameSnapshot     String?                @db.VarChar(255)
  uomCodeSnapshot          String?                @db.VarChar(50)
  // Working fields
  itemName                 String                 @db.VarChar(200)
  orderedQuantity          Decimal                @default(0) @db.Decimal(18, 4)
  receivedQuantity         Decimal                @db.Decimal(18, 4)
  acceptedQuantity         Decimal                @default(0) @db.Decimal(18, 4)
  rejectedQuantity         Decimal                @default(0) @db.Decimal(18, 4)
  unit                     String                 @default("KG") @db.VarChar(50)
  packageCondition         String                 @default("INTACT") @db.VarChar(50)
  batchNumber              String?                @db.VarChar(100)
  expiryDate               DateTime?              @db.Date
  notes                    String?                @db.Text
  createdAt                DateTime               @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime               @updatedAt @db.Timestamptz(6)

  goodsReceiptNote         GoodsReceiptNote       @relation(fields: [grnId], references: [id], onDelete: Cascade)
  poItem                   PurchaseOrderItem?     @relation(fields: [poItemId], references: [id], onDelete: SetNull)

  @@index([grnId])
  @@index([materialId])
  @@map("goods_receipt_note_items")
}

model VendorPerformance {
  id                  String                @id @default(uuid()) @db.Uuid
  vendorId            String                @db.Uuid
  companyId           String                @db.Uuid
  totalOrders         Int                   @default(0)
  completedOrders     Int                   @default(0)
  onTimeDeliveryRate  Decimal               @default(100.0) @db.Decimal(5, 2)
  rejectionRate       Decimal               @default(0.0) @db.Decimal(5, 2)
  averageLeadDays     Decimal               @default(0.0) @db.Decimal(5, 1)
  overallRating       Decimal               @default(5.0) @db.Decimal(3, 2) // 1.0 to 5.0
  lastEvaluatedAt     DateTime              @default(now()) @db.Timestamptz(6)
  evaluationNotes     String?               @db.Text
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  vendor              Vendor                @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([vendorId, companyId])
  @@index([companyId, overallRating])
  @@map("vendor_performances")
}

// ==========================================
// PHASE 4.5 — MASTER DATA EXPANSION
// Inventory & Item Masters
// Manufacturing Masters
// Commercial Configuration
// Intercompany Foundation
// ==========================================

// ==========================================
// UOM MASTER
// ==========================================

model UnitOfMeasure {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  code            String    @db.VarChar(50)   // KG, TON, BAG, LITER, PIECE, PACK
  name            String    @db.VarChar(100)
  category        String    @db.VarChar(50)   // WEIGHT, VOLUME, COUNT, LENGTH
  symbol          String?   @db.VarChar(20)
  decimalPlaces   Int       @default(3)       // Precision for this UOM
  isBaseUnit      Boolean   @default(false)   // True for base units like KG, LITER
  status          String    @default("ACTIVE") @db.VarChar(50)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @db.Timestamptz(6)

  fromConversions UomConversion[] @relation("FromUom")
  toConversions   UomConversion[] @relation("ToUom")
  rawMaterialsBase    RawMaterial[]    @relation("RawMatBaseUom")
  rawMaterialsPurchase RawMaterial[]   @relation("RawMatPurchaseUom")
  packingMaterialsBase PackingMaterial[] @relation("PackMatBaseUom")
  packingMaterialsPurchase PackingMaterial[] @relation("PackMatPurchaseUom")
  finishedProductsBase FinishedProduct[] @relation("FpBaseUom")
  finishedProductsSales FinishedProduct[] @relation("FpSalesUom")
  packSizes       PackSize[]
  productionLines ProductionLine[]
  formulaBoms     FormulaBom[]
  formulaComponents FormulaBomComponent[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("units_of_measure")
}

model UomConversion {
  id               String         @id @default(uuid()) @db.Uuid
  organizationId   String         @db.Uuid
  fromUomId        String         @db.Uuid
  toUomId          String         @db.Uuid
  conversionFactor Decimal        @db.Decimal(18, 8) // e.g. 1000 for TON->KG
  // Context: if set, conversion is specific to this material/product
  rawMaterialId    String?        @db.Uuid
  packingMaterialId String?       @db.Uuid
  finishedProductId String?       @db.Uuid
  effectiveFrom    DateTime?      @db.Date
  effectiveTo      DateTime?      @db.Date
  status           String         @default("ACTIVE") @db.VarChar(50)
  createdAt        DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(6)

  fromUom          UnitOfMeasure  @relation("FromUom", fields: [fromUomId], references: [id], onDelete: Restrict)
  toUom            UnitOfMeasure  @relation("ToUom", fields: [toUomId], references: [id], onDelete: Restrict)

  @@index([fromUomId, toUomId])
  @@index([organizationId])
  @@map("uom_conversions")
}

// ==========================================
// MATERIAL CATEGORY MASTER
// ==========================================

model MaterialCategory {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  code           String    @db.VarChar(50)
  name           String    @db.VarChar(100)
  description    String?   @db.Text
  categoryType   String    @default("RAW_MATERIAL") @db.VarChar(50) // RAW_MATERIAL, PACKING_MATERIAL, BOTH
  status         String    @default("ACTIVE") @db.VarChar(50)
  createdAt      DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime  @updatedAt @db.Timestamptz(6)

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  rawMaterials   RawMaterial[]
  packingMaterials PackingMaterial[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("material_categories")
}

// ==========================================
// RAW MATERIAL MASTER
// ==========================================

model RawMaterial {
  id                      String            @id @default(uuid()) @db.Uuid
  organizationId          String            @db.Uuid
  companyId               String            @db.Uuid
  categoryId              String?           @db.Uuid
  baseUomId               String?           @db.Uuid
  purchaseUomId           String?           @db.Uuid
  materialCode            String            @db.VarChar(100)
  materialName            String            @db.VarChar(255)
  description             String?           @db.Text
  purchaseConversionFactor Decimal?         @db.Decimal(18, 8) // e.g. 1000 for TON->KG
  batchControlled         Boolean           @default(false)
  expiryControlled        Boolean           @default(false)
  shelfLifeDays           Int?
  qcRequired              Boolean           @default(false)
  minimumStock            Decimal?          @db.Decimal(18, 4)
  maximumStock            Decimal?          @db.Decimal(18, 4)
  reorderLevel            Decimal?          @db.Decimal(18, 4)
  storageRequirements     String?           @db.VarChar(255)
  grade                   String?           @db.VarChar(100)
  specifications          String?           @db.Text
  isHazardous             Boolean           @default(false)
  standardCost            Decimal?          @db.Decimal(18, 4)   // Reference only — not authoritative
  lastPurchaseCost        Decimal?          @db.Decimal(18, 4)
  averageCost             Decimal?          @db.Decimal(18, 4)
  hsCode                  String?           @db.VarChar(50)
  status                  String            @default("ACTIVE") @db.VarChar(50) // ACTIVE, INACTIVE, BLOCKED, ARCHIVED
  approvalStatus          String            @default("DRAFT") @db.VarChar(50) // DRAFT, PENDING_APPROVAL, APPROVED
  createdAt               DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt               DateTime?         @db.Timestamptz(6)

  organization            Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company                 Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category                MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUom                 UnitOfMeasure?    @relation("RawMatBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  purchaseUom             UnitOfMeasure?    @relation("RawMatPurchaseUom", fields: [purchaseUomId], references: [id], onDelete: Restrict)
  formulaComponents       FormulaBomComponent[]
  qcSpecifications        QcSpecification[]
  purchaseInvoiceItems    PurchaseInvoiceItem[]
  purchaseReturnItems     PurchaseReturnItem[]
  warehouseStocks         WarehouseStock[]

  @@unique([companyId, materialCode])
  @@index([organizationId])
  @@index([companyId])
  @@index([categoryId])
  @@map("raw_materials")
}

// ==========================================
// PACKING MATERIAL MASTER
// ==========================================

model PackingMaterial {
  id                    String            @id @default(uuid()) @db.Uuid
  organizationId        String            @db.Uuid
  companyId             String            @db.Uuid
  categoryId            String?           @db.Uuid
  baseUomId             String?           @db.Uuid
  purchaseUomId         String?           @db.Uuid
  materialCode          String            @db.VarChar(100)
  materialName          String            @db.VarChar(255)  // e.g. "Printed 50kg PP Bag"
  description           String?           @db.Text
  packCompatibility     String?           @db.VarChar(255)  // Which products this packing fits
  batchControlled       Boolean           @default(false)
  minimumStock          Decimal?          @db.Decimal(18, 4)
  maximumStock          Decimal?          @db.Decimal(18, 4)
  reorderLevel          Decimal?          @db.Decimal(18, 4)
  standardCost          Decimal?          @db.Decimal(18, 4)
  lastPurchaseCost      Decimal?          @db.Decimal(18, 4)
  status                String            @default("ACTIVE") @db.VarChar(50)
  approvalStatus        String            @default("DRAFT") @db.VarChar(50)
  createdAt             DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(6)
  deletedAt             DateTime?         @db.Timestamptz(6)

  organization          Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category              MaterialCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  baseUom               UnitOfMeasure?    @relation("PackMatBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  purchaseUom           UnitOfMeasure?    @relation("PackMatPurchaseUom", fields: [purchaseUomId], references: [id], onDelete: Restrict)
  formulaComponents     FormulaBomComponent[]
  purchaseInvoiceItems  PurchaseInvoiceItem[]
  purchaseReturnItems   PurchaseReturnItem[]
  warehouseStocks       WarehouseStock[]

  @@unique([companyId, materialCode])
  @@index([organizationId])
  @@index([companyId])
  @@map("packing_materials")
}

// ==========================================
// PRODUCT CATEGORY MASTER
// ==========================================

model ProductCategory {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  code           String            @db.VarChar(50)
  name           String            @db.VarChar(100)
  description       String?           @db.Text
  taxClassification String?           @db.VarChar(100)
  taxRate           Decimal?          @db.Decimal(5, 2)
  status            String            @default("ACTIVE") @db.VarChar(50)
  createdAt         DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime          @updatedAt @db.Timestamptz(6)

  finishedProducts FinishedProduct[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("product_categories")
}

// ==========================================
// PACK SIZE MASTER
// ==========================================

model PackSize {
  id        String    @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  code      String    @db.VarChar(50)  // 50KG, 25KG, 5L
  name      String    @db.VarChar(100) // e.g. "50 KG Bag"
  quantity  Decimal   @db.Decimal(18, 4)
  uomId     String?   @db.Uuid
  status    String    @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt DateTime  @updatedAt @db.Timestamptz(6)

  uom             UnitOfMeasure?  @relation(fields: [uomId], references: [id], onDelete: SetNull)
  finishedProducts FinishedProduct[]
  rateListItems   RateListItem[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("pack_sizes")
}

// ==========================================
// FINISHED PRODUCT MASTER
// ==========================================

model FinishedProduct {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @db.Uuid
  companyId            String          @db.Uuid
  categoryId           String?         @db.Uuid
  packSizeId           String?         @db.Uuid
  baseUomId            String?         @db.Uuid
  salesUomId           String?         @db.Uuid
  productCode          String          @db.VarChar(100)
  sku                  String?         @db.VarChar(100)
  productName          String          @db.VarChar(255)
  brand                String?         @db.VarChar(100)
  grade                String?         @db.VarChar(100)  // A-Grade, Premium, Standard
  fertilizerType       String?         @db.VarChar(100)  // Urea, DAP, NPK, SOP, etc.
  productForm          String?         @db.VarChar(50)   // GRANULAR, POWDER, LIQUID, PRILLED
  bagWeight            Decimal?        @db.Decimal(18, 4)
  barcode              String?         @db.VarChar(100)
  batchControlled      Boolean         @default(true)
  expiryControlled     Boolean         @default(false)
  shelfLifeDays        Int?
  minimumStock         Decimal?        @db.Decimal(18, 4)
  reorderLevel         Decimal?        @db.Decimal(18, 4)
  standardCost         Decimal?        @db.Decimal(18, 4)   // Reference only
  defaultSellingPrice  Decimal?        @db.Decimal(18, 4)   // Reference only
  hsCode               String?         @db.VarChar(50)
  status               String          @default("ACTIVE") @db.VarChar(50)
  approvalStatus       String          @default("DRAFT") @db.VarChar(50)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)
  deletedAt            DateTime?       @db.Timestamptz(6)

  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  category             ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  packSize             PackSize?       @relation(fields: [packSizeId], references: [id], onDelete: SetNull)
  baseUom              UnitOfMeasure?  @relation("FpBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  salesUom             UnitOfMeasure?  @relation("FpSalesUom", fields: [salesUomId], references: [id], onDelete: Restrict)
  formulaBoms          FormulaBom[]
  qcSpecifications     QcSpecification[]
  icPricingRules       IntercompanyPricingRule[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  salesOrderItems      SalesOrderItem[]
  salesInvoiceItems    SalesInvoiceItem[]
  salesReturnItems     SalesReturnItem[]
  warehouseStocks      WarehouseStock[]
  productRateLists     ProductRateList[]
  rateListItems        RateListItem[]
  provisionalReceiptProducts ProvisionalReceiptProduct[]

  @@unique([companyId, productCode])
  @@index([organizationId])
  @@index([companyId])
  @@map("finished_products")
}

// ==========================================
// WAREHOUSE LOCATION HIERARCHY
// ==========================================

model WarehouseLocation {
  id                     String              @id @default(uuid()) @db.Uuid
  warehouseId            String              @db.Uuid
  parentLocationId       String?             @db.Uuid  // Self-referential for Zone > Rack > Bin
  locationCode           String              @db.VarChar(50)
  locationName           String              @db.VarChar(200)
  locationType           String              @db.VarChar(50)  // ZONE, RACK, BIN, SHELF
  capacity               Decimal?            @db.Decimal(18, 4)
  capacityUom            String?             @db.VarChar(20)
  allowedMaterialCategory String?            @db.VarChar(100) // Optional category restriction
  status                 String              @default("ACTIVE") @db.VarChar(50)
  createdAt              DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt              DateTime            @updatedAt @db.Timestamptz(6)

  warehouse              Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  parentLocation         WarehouseLocation?  @relation("LocationHierarchy", fields: [parentLocationId], references: [id], onDelete: Restrict)
  childLocations         WarehouseLocation[] @relation("LocationHierarchy")

  @@unique([warehouseId, locationCode])
  @@index([warehouseId])
  @@index([parentLocationId])
  @@map("warehouse_locations")
}

// ==========================================
// PRODUCTION LINE MASTER
// ==========================================

model ProductionLine {
  id                  String         @id @default(uuid()) @db.Uuid
  companyId           String         @db.Uuid
  plantId             String?        @db.Uuid
  lineCode            String         @db.VarChar(50)
  lineName            String         @db.VarChar(200)
  capacity            Decimal?       @db.Decimal(18, 4)
  capacityUomId       String?        @db.Uuid
  productCompatibility String?       @db.Text  // JSON or comma-separated product codes
  status              String         @default("ACTIVE") @db.VarChar(50)
  createdAt           DateTime       @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(6)

  company             Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant               Plant?         @relation(fields: [plantId], references: [id], onDelete: SetNull)
  capacityUom         UnitOfMeasure? @relation(fields: [capacityUomId], references: [id], onDelete: SetNull)

  @@unique([companyId, lineCode])
  @@index([companyId])
  @@map("production_lines")
}

// ==========================================
// SHIFT MASTER
// ==========================================

model Shift {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @db.Uuid
  plantId   String?  @db.Uuid
  shiftCode String   @db.VarChar(50)
  shiftName String   @db.VarChar(100)  // Morning, Evening, Night
  startTime String   @db.VarChar(10)   // HH:MM format
  endTime   String   @db.VarChar(10)
  status    String   @default("ACTIVE") @db.VarChar(50)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @db.Timestamptz(6)

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plant     Plant?   @relation(fields: [plantId], references: [id], onDelete: SetNull)

  @@unique([companyId, shiftCode])
  @@index([companyId])
  @@map("shifts")
}

// ==========================================
// QC SPECIFICATION FOUNDATION
// ==========================================

model QcSpecification {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  companyId      String              @db.Uuid
  code           String              @db.VarChar(100)
  name           String              @db.VarChar(255)
  appliesToType  String              @db.VarChar(50)  // RAW_MATERIAL | FINISHED_PRODUCT
  rawMaterialId  String?             @db.Uuid
  finishedProductId String?          @db.Uuid
  version        Int                 @default(1)
  effectiveFrom  DateTime?           @db.Date
  effectiveTo    DateTime?           @db.Date
  status         String              @default("DRAFT") @db.VarChar(50)
  approvalStatus String              @default("DRAFT") @db.VarChar(50)
  createdAt      DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt      DateTime            @updatedAt @db.Timestamptz(6)

  rawMaterial    RawMaterial?        @relation(fields: [rawMaterialId], references: [id], onDelete: SetNull)
  finishedProduct FinishedProduct?   @relation(fields: [finishedProductId], references: [id], onDelete: SetNull)
  parameters     QcParameter[]

  @@unique([companyId, code, version])
  @@index([organizationId])
  @@index([companyId])
  @@map("qc_specifications")
}

model QcParameter {
  id               String          @id @default(uuid()) @db.Uuid
  specificationId  String          @db.Uuid
  parameterName    String          @db.VarChar(200)
  minimumValue     Decimal?        @db.Decimal(18, 6)
  maximumValue     Decimal?        @db.Decimal(18, 6)
  targetValue      Decimal?        @db.Decimal(18, 6)
  uom              String?         @db.VarChar(50)  // %, ppm, mg/kg
  testMethod       String?         @db.VarChar(200)
  mandatory        Boolean         @default(true)
  sortOrder        Int             @default(0)
  createdAt        DateTime        @default(now()) @db.Timestamptz(6)

  specification    QcSpecification @relation(fields: [specificationId], references: [id], onDelete: Cascade)

  @@index([specificationId])
  @@map("qc_parameters")
}

// ==========================================
// FORMULA / BOM MASTER
// ==========================================

model FormulaBom {
  id                  String                @id @default(uuid()) @db.Uuid
  organizationId      String                @db.Uuid
  companyId           String                @db.Uuid
  finishedProductId   String                @db.Uuid
  formulaCode         String                @db.VarChar(100)
  version             Int                   @default(1)
  standardBatchSize   Decimal               @db.Decimal(18, 4)
  batchSizeUomId      String?               @db.Uuid
  effectiveFrom       DateTime?             @db.Date
  effectiveTo         DateTime?             @db.Date
  notes               String?               @db.Text
  status              String                @default("DRAFT") @db.VarChar(50)
  // DRAFT | PENDING_APPROVAL | APPROVED | ACTIVE | SUPERSEDED
  approvalStatus      String                @default("DRAFT") @db.VarChar(50)
  approvedAt          DateTime?             @db.Timestamptz(6)
  approvedById        String?               @db.Uuid
  createdAt           DateTime              @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime              @updatedAt @db.Timestamptz(6)

  finishedProduct     FinishedProduct       @relation(fields: [finishedProductId], references: [id], onDelete: Restrict)
  batchSizeUom        UnitOfMeasure?        @relation(fields: [batchSizeUomId], references: [id], onDelete: SetNull)
  components          FormulaBomComponent[]

  @@unique([companyId, formulaCode, version])
  @@index([organizationId])
  @@index([companyId])
  @@map("formula_boms")
}

model FormulaBomComponent {
  id                      String          @id @default(uuid()) @db.Uuid
  formulaId               String          @db.Uuid
  // COMPONENT TYPE: RAW_MATERIAL | PACKING_MATERIAL
  componentType           String          @db.VarChar(50)
