// ==========================================
// 12. PRICING & RATE LIST MANAGEMENT
// ==========================================

enum PricingPhase {
  CASH
  SEASONAL
  ADVANCE_BOOKING
  VD
  NET_RATE
}

model ProductRateList {
  id                  String       @id @default(uuid()) @db.Uuid
  organizationId      String       @db.Uuid
  companyId           String       @db.Uuid
  finishedProductId   String       @db.Uuid
  phase               PricingPhase @default(CASH)
  baseRate            Decimal      @db.Decimal(18, 4)
  cashDiscountPercent Decimal      @default(0) @db.Decimal(8, 2)
  minAllowedRate      Decimal?     @db.Decimal(18, 4)
  effectiveDate       DateTime     @default(now()) @db.Timestamptz(6)
  isActive            Boolean      @default(true)
  createdAt           DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(6)

  organization        Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company             Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  finishedProduct     FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)

  @@unique([companyId, finishedProductId, phase])
  @@index([organizationId])
  @@index([companyId])
  @@index([finishedProductId])
  @@map("product_rate_lists")
}

model PricingAuthorityLimit {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @db.Uuid
  companyId             String    @db.Uuid
  roleCode              String    @db.VarChar(50) // SALES_OFFICER, AREA_MANAGER, BUSINESS_MANAGER, ADMIN
  maxDiscountPct        Decimal   @db.Decimal(8, 2)
  canSetNetRate         Boolean   @default(false)
  canApplySpecialRate   Boolean   @default(false)
  canApproveOwnOverride Boolean   @default(false)
  requiresApproval      Boolean   @default(true)
  companyScope          String?   @default("COMPANY") @db.VarChar(100)
  effectiveDate         DateTime? @default(now()) @db.Timestamptz(6)
  status                String    @default("ACTIVE") @db.VarChar(50)
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(6)

  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company               Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@unique([companyId, roleCode])
  @@index([organizationId])
  @@index([companyId])
  @@map("pricing_authority_limits")
}

model RateList {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @db.Uuid
  companyId          String            @db.Uuid
  code               String            @db.VarChar(50)
  name               String            @db.VarChar(200)
  description        String?           @db.Text
  category           String            @default("SEASONAL") @db.VarChar(100) // SEASONAL, CASH, ADVANCE_BOOKING, VD, NET_RATE, PACKAGE, SPECIAL, MELA, GENERAL
  currency           String            @default("PKR") @db.VarChar(10)
  status             String            @default("ACTIVE") @db.VarChar(50) // DRAFT, ACTIVE, INACTIVE, ARCHIVED
  isMobileVisible    Boolean           @default(true)
  isMobileSelectable Boolean           @default(true)
  isInternalOnly     Boolean           @default(false)
  priority           Int               @default(0)
  createdById        String?           @db.VarChar(100)
  approvedById       String?           @db.VarChar(100)
  createdAt          DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime          @updatedAt @db.Timestamptz(6)

  organization       Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company            Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  versions           RateListVersion[]
  salesOrders        SalesOrder[]
  salesOrderItems    SalesOrderItem[]
  pricingSchemes     PricingScheme[]   @relation("BaseRateListSchemes")

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([category])
  @@index([status])
  @@map("rate_lists")
}

model RateListVersion {
  id                 String          @id @default(uuid()) @db.Uuid
  rateListId         String          @db.Uuid
  versionNumber      Int             @default(1)
  effectiveFrom      DateTime        @db.Timestamptz(6)
  effectiveTo        DateTime?       @db.Timestamptz(6)
  status             String          @default("ACTIVE") @db.VarChar(50) // DRAFT, PENDING_APPROVAL, ACTIVE, EXPIRED, ARCHIVED, CANCELLED
  notes              String?         @db.Text
  createdById        String?         @db.VarChar(100)
  approvedById       String?         @db.VarChar(100)
  approvedAt         DateTime?       @db.Timestamptz(6)
  publishedAt        DateTime?       @db.Timestamptz(6)
  createdAt          DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @db.Timestamptz(6)

  rateList           RateList        @relation(fields: [rateListId], references: [id], onDelete: Cascade)
  items              RateListItem[]
  salesOrders        SalesOrder[]
  salesOrderItems    SalesOrderItem[]

  @@unique([rateListId, versionNumber])
  @@index([rateListId])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("rate_list_versions")
}

model RateListItem {
  id                  String          @id @default(uuid()) @db.Uuid
  rateListVersionId   String          @db.Uuid
  finishedProductId   String          @db.Uuid
  packSizeId          String?         @db.Uuid
  baseRate            Decimal         @db.Decimal(18, 4)
  unit                String?         @default("BAG") @db.VarChar(50)
  discountType        String?         @default("PERCENTAGE") @db.VarChar(50) // PERCENTAGE, FLAT
  discountValue       Decimal         @default(0) @db.Decimal(18, 4)
  fixedNetRate        Decimal?        @db.Decimal(18, 4)
  minAllowedRate      Decimal?        @db.Decimal(18, 4)
  quantityFrom        Decimal         @default(1) @db.Decimal(18, 4)
  quantityTo          Decimal?        @db.Decimal(18, 4)
  freeQuantity        Decimal         @default(0) @db.Decimal(18, 4)
  commercialCondition String?         @db.VarChar(255)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(6)

  rateListVersion     RateListVersion @relation(fields: [rateListVersionId], references: [id], onDelete: Cascade)
  finishedProduct     FinishedProduct @relation(fields: [finishedProductId], references: [id], onDelete: Cascade)
  packSize            PackSize?       @relation(fields: [packSizeId], references: [id], onDelete: SetNull)

  @@index([rateListVersionId])
  @@index([finishedProductId])
  @@index([packSizeId])
  @@map("rate_list_items")
}

model PricingScheme {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @db.Uuid
  companyId            String          @db.Uuid
  code                 String          @db.VarChar(50)
  name                 String          @db.VarChar(200)
  description          String?         @db.Text
  schemeType           String          @default("CASH_DISCOUNT") @db.VarChar(50) // CASH_DISCOUNT, ADVANCE_BOOKING, PACKAGE, SPECIAL_RATE, VOLUME_DISCOUNT, NET_RATE, MELA_EVENT, CREDIT_COMMERCIAL, OTHER
  calculationMethod    String          @default("ADDITIVE") @db.VarChar(50) // ADDITIVE, SEQUENTIAL
  discountComponents   Json?           // Array of { name: string, type: 'PERCENTAGE' | 'FLAT', value: number }
  baseRateListId       String?         @db.Uuid
  paidQuantity         Decimal?        @default(0) @db.Decimal(18, 4)
  freeQuantity         Decimal?        @default(0) @db.Decimal(18, 4)
  minQuantity          Decimal?        @default(0) @db.Decimal(18, 4)
  maxQuantity          Decimal?        @db.Decimal(18, 4)
  applicableDealerTier String?         @default("ALL") @db.VarChar(50)
  paymentTerm          String?         @default("ANY") @db.VarChar(50) // CASH, CREDIT, ADVANCE, ANY
  effectiveFrom        DateTime        @db.Timestamptz(6)
  effectiveTo          DateTime?       @db.Timestamptz(6)
  isMobileVisible      Boolean         @default(true)
  isMobileSelectable   Boolean         @default(true)
  isInternalOnly       Boolean         @default(false)
  priority             Int             @default(0)
  status               String          @default("ACTIVE") @db.VarChar(50) // DRAFT, ACTIVE, EXPIRED, ARCHIVED
  createdById          String?         @db.VarChar(100)
  approvedById         String?         @db.VarChar(100)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company              Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  baseRateList         RateList?       @relation("BaseRateListSchemes", fields: [baseRateListId], references: [id], onDelete: SetNull)
  salesOrders          SalesOrder[]
  salesOrderItems      SalesOrderItem[]

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([schemeType])
  @@index([status, effectiveFrom, effectiveTo])
  @@map("pricing_schemes")
}

// ==========================================
// 12. FINANCIAL ACCOUNTING & GENERAL LEDGER (GL)
// ==========================================

model Account {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  companyId        String?           @db.Uuid
  accountCode      String            @db.VarChar(50) // e.g. "101000", "102000", "103000", "201000", "401000", "501000", "601000"
  accountName      String            @db.VarChar(200)
  accountType      String            @db.VarChar(50) // ASSET, LIABILITY, EQUITY, REVENUE, EXPENSE
  category         String            @db.VarChar(100) // CURRENT_ASSET, NON_CURRENT_ASSET, CURRENT_LIABILITY, EQUITY, OPERATING_REVENUE, COGS, OPERATING_EXPENSE, TAX
  currency         String            @default("PKR") @db.VarChar(10)
  isSystem         Boolean           @default(false)
  isActive         Boolean           @default(true)
  currentBalance   Decimal           @default(0) @db.Decimal(18, 4)
  notes            String?           @db.Text
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company?          @relation(fields: [companyId], references: [id], onDelete: SetNull)
  journalLines     JournalEntryLine[]
  expenseAccounts  ExpenseEntry[]    @relation("ExpenseAccount")
  paymentAccounts  ExpenseEntry[]    @relation("PaymentAccount")
  financialTxAccounts FinancialTransaction[] @relation("FinancialTxAccount")
  financialTxContraAccounts FinancialTransaction[] @relation("FinancialTxContraAccount")

  @@unique([organizationId, accountCode])
  @@index([organizationId, accountType])
  @@index([companyId])
  @@map("accounts")
}

model JournalEntry {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @db.Uuid
  companyId        String            @db.Uuid
  entryNumber      String            @db.VarChar(50) // e.g. "JV-2026-00001", "SJ-2026-00001", "PJ-2026-00001"
  entryDate        DateTime          @db.Timestamptz(6)
  sourceType       String            @db.VarChar(50) // SALES_INVOICE, PURCHASE_INVOICE, DEALER_PAYMENT, VENDOR_PAYMENT, EXPENSE, MANUAL_JOURNAL
  sourceId         String?           @db.Uuid
  referenceNumber  String?           @db.VarChar(100)
  description      String?           @db.Text
  totalDebit       Decimal           @default(0) @db.Decimal(18, 4)
  totalCredit      Decimal           @default(0) @db.Decimal(18, 4)
  isBalanced       Boolean           @default(true)
  status           String            @default("POSTED") @db.VarChar(50) // DRAFT, POSTED, REVERSED
  createdById      String?           @db.VarChar(100)
  createdAt        DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(6)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  lines            JournalEntryLine[]

  @@unique([companyId, entryNumber])
  @@index([organizationId])
  @@index([companyId, entryDate])
  @@index([sourceType, sourceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id               String            @id @default(uuid()) @db.Uuid
  journalEntryId   String            @db.Uuid
  accountId        String            @db.Uuid
  debit            Decimal           @default(0) @db.Decimal(18, 4)
  credit           Decimal           @default(0) @db.Decimal(18, 4)
