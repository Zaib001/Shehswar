  approvedById       String?      @db.VarChar(100)
  approvedAt         DateTime?    @db.Timestamptz(6)
  overrideReason     String?      @db.Text
  status             String       @default("POSTED") @db.VarChar(50)
  createdById        String?      @db.VarChar(100)
