  salesInvoices          SalesInvoice[]
  salesReturns           SalesReturn[]
  dealerPayments         DealerPaymentReceipt[]
  ledgerEntries          DealerLedgerEntry[]
  gatePasses             GatePass[]
  provisionalReceipts    ProvisionalReceipt[]
  provisionalReceiptAllocations ProvisionalReceiptAllocation[]

  @@unique([companyId, code])
  @@index([organizationId])
  @@index([companyId])
  @@index([territoryId])
  @@index([assignedFieldOfficerId])
  @@map("dealers")
}

