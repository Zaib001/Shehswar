// ==========================================
// INTERCOMPANY PRICING RULE FOUNDATION
// ==========================================

model IntercompanyPricingRule {
  id                    String          @id @default(uuid()) @db.Uuid
  organizationId        String          @db.Uuid
  sourceCompanyId       String          @db.Uuid   // e.g. Shehswar (parent/manufacturer)
  targetCompanyId       String          @db.Uuid   // e.g. Nectar, consceptAG
  finishedProductId     String?         @db.Uuid   // Specific product, or null for category-wide
  productCategoryId     String?         @db.Uuid   // Applied per product category
  // PERCENTAGE | FIXED_AMOUNT | MANUAL_APPROVED_PRICE
  pricingMethod         String          @db.VarChar(50)
  markupPercent         Decimal?        @db.Decimal(5, 2)
  fixedMarkupAmount     Decimal?        @db.Decimal(18, 2)
  manualApprovedPrice   Decimal?        @db.Decimal(18, 4)
  effectiveFrom         DateTime?       @db.Date
  effectiveTo           DateTime?       @db.Date
  approvalStatus        String          @default("DRAFT") @db.VarChar(50) // DRAFT | PENDING_APPROVAL | APPROVED
  approvedAt            DateTime?       @db.Timestamptz(6)
  approvedById          String?         @db.Uuid
  notes                 String?         @db.Text
  status                String          @default("ACTIVE") @db.VarChar(50)
  createdAt             DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime        @updatedAt @db.Timestamptz(6)

  sourceCompany         Company         @relation("IcSourceCompany", fields: [sourceCompanyId], references: [id], onDelete: Restrict)
  targetCompany         Company         @relation("IcTargetCompany", fields: [targetCompanyId], references: [id], onDelete: Restrict)
  finishedProduct       FinishedProduct? @relation(fields: [finishedProductId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([sourceCompanyId, targetCompanyId])
  @@map("intercompany_pricing_rules")
}

