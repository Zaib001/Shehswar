{
  "name": "shehswar-one360",
  "version": "1.0.0",
  "private": true,
  "description": "Shehswar ONE360 - Enterprise ERP & CRM Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "db:generate": "npm run generate --workspace=@shehswar/database",
    "db:migrate": "npm run migrate --workspace=@shehswar/database",
    "db:push": "prisma db push --skip-generate --schema=packages/database/prisma/schema.prisma",
    "db:seed": "npm run seed --workspace=@shehswar/database",
    "db:seed:admin": "npm run seed:admin --workspace=@shehswar/database",
    "db:seed:system": "npm run seed:system --workspace=@shehswar/database",
    "db:seed:client": "npm run seed:client --workspace=@shehswar/database",
    "db:seed:dev": "npm run seed:dev --workspace=@shehswar/database",
    "render:build:api": "npm run db:generate && turbo run build --filter=@shehswar/api...",
    "render:start:api": "npm run db:push && npm run db:seed:admin && npm run start:prod --workspace=@shehswar/api",
    "render:build:web": "turbo run build --filter=@shehswar/web...",
    "render:start:web": "npm run start --workspace=@shehswar/web"
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.2",
    "typescript": "^5.6.2"
  },
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "author": "Shehswar Architecture Team",
  "license": "UNLICENSED"
}
