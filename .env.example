# ==============================================================================
# SHEHSWAR ONE360 - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: Never commit sensitive credentials or production secrets to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RUNTIME & APPLICATION ENVIRONMENT
# ------------------------------------------------------------------------------
# Allowed values: development | staging | production | test
NODE_ENV=development
APP_NAME=shehswar-one360
PORT=4000
CORS_ORIGIN=http://localhost:3000

# Frontend public API target
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. DATABASE PERSISTENCE (POSTGRESQL 16)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=[schema]
# [DEVELOPMENT DEFAULT]
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5432/shehswar_one360?schema=public"

# Connection Pool Tuning (PGBouncer or Direct)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ------------------------------------------------------------------------------
# 3. CACHING & BACKGROUND QUEUES (REDIS 7)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# ------------------------------------------------------------------------------
# 4. IDENTITY, JWT & AUTHENTICATION SECRETS
# ------------------------------------------------------------------------------
# Generate 256-bit cryptographic secrets in staging/production via:
#   openssl rand -base64 48
JWT_ACCESS_SECRET="shehswar_enterprise_jwt_access_super_secret_key_2026_dev_only"
JWT_ACCESS_EXPIRATION="15m"

JWT_REFRESH_SECRET="shehswar_enterprise_jwt_refresh_super_secret_key_2026_dev_only"
JWT_REFRESH_EXPIRATION="7d"

PASSWORD_SALT_ROUNDS=12

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (S3 / MINIO / CLOUDFLARE R2 / LOCAL)
# ------------------------------------------------------------------------------
# Providers: s3 | r2 | minio | local
STORAGE_PROVIDER=local
STORAGE_BUCKET=shehswar-documents
STORAGE_REGION=us-east-1

# For MinIO local development:
# STORAGE_ENDPOINT=http://localhost:9000
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=miniopassword

# For Local Disk fallback:
STORAGE_LOCAL_ROOT=./uploads

# ------------------------------------------------------------------------------
# 6. LOGGING & OBSERVABILITY
# ------------------------------------------------------------------------------
# Options: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
ENABLE_PRETTY_LOG=true

# ------------------------------------------------------------------------------
# 7. RATE LIMITING & SECURITY DEFENSES
# ------------------------------------------------------------------------------
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100
